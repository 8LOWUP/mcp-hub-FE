# ===========================================
# MCP Hub Frontend - 로컬 개발 환경 설정
# ===========================================

# API 서버 URL
NEXT_PUBLIC_API_URL=https://mcphubcorp.site/
NEXT_PUBLIC_API_IMAGE_URL=https://mcphubcorp.site/

# 프론트 배포서버 URL
NEXT_PUBLIC_BASE_URL=https://8lowup-mcp-hub.vercel.app/

# NextAuth 설정
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-change-this-in-production

# OAuth 설정 (Google)
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# OAuth 설정 (Kakao)
KAKAO_CLIENT_ID=your-kakao-client-id-here
KAKAO_CLIENT_SECRET=your-kakao-client-secret-here

# 데이터베이스 설정 (필요시)
# DATABASE_URL=postgresql://username:password@localhost:5432/mcp_hub

# Redis 설정 (필요시)
# REDIS_URL=redis://localhost:6379

# 파일 업로드 설정
NEXT_PUBLIC_MAX_FILE_SIZE=10485760
NEXT_PUBLIC_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# 개발 모드 설정
NODE_ENV=development
NEXT_PUBLIC_DEBUG=true

# 로깅 설정
NEXT_PUBLIC_LOG_LEVEL=debug
